{
  "expo": {
    "name": "Inventra",
    "slug": "inventra",
    "version": "1.0.0",
    "scheme": "inventra",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inventra.app",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.inventra.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "usesCleartextTraffic": false,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Inventra à utiliser la caméra pour scanner les codes-barres."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Inventra à accéder à vos photos pour ajouter une image de produit."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "to-set-after-eas-init"
      }
    }
  }
}
