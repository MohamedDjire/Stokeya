{
  "expo": {
    "name": "Stokeya",
    "slug": "stokeya",
    "version": "1.0.0",
    "scheme": "stokeya",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stokeya.app",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.stokeya.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1F3A"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Stokeya à utiliser la caméra pour scanner les codes-barres."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Stokeya à accéder à vos photos pour ajouter une image de produit."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1F3A"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "to-set-after-eas-init"
      }
    }
  }
}
