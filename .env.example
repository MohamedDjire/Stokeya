# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=api.stokeya.com,localhost,127.0.0.1

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=inventra
DB_USER=inventra
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=https://stokeya.com
CORS_ALLOW_ALL_ORIGINS=False

# Wave Business API (https://business.wave.com)
WAVE_API_KEY=wave_sn_prod_xxx
WAVE_WEBHOOK_SECRET=whsec_xxx
WAVE_API_BASE_URL=https://api.wave.com
WAVE_SUCCESS_URL=https://stokeya.com/payment/success
WAVE_ERROR_URL=https://stokeya.com/payment/error

# Orange Money Web Payment
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_BASE_URL=https://api.orange.com/orange-money-webpay/dev/v1
ORANGE_MONEY_NOTIF_URL=https://api.stokeya.com/api/v1/payments/orange/webhook/

# MTN Mobile Money Collection
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_DEFAULT_PAYER=22997000000

# Mock paiements (DEBUG uniquement)
PAYMENT_MOCK_BASE_URL=http://localhost:5173

# PayPal (https://developer.paypal.com — Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=EUR
PAYPAL_XOF_RATE=655.957
PAYPAL_RETURN_URL=http://localhost:5173/payment/success
PAYPAL_CANCEL_URL=http://localhost:5173/payment/error
PAYPAL_WEBHOOK_ID=

# SasPay (https://docs.saspay.me — clé sk_test_... ou sk_live_..., jamais dans le frontend)
# Webhook à enregistrer dans le tableau de bord SasPay :
#   https://api.stokeya.com/api/v1/payments/saspay/webhook/
#   événements : transaction.success, transaction.failed, transaction.cancelled
SASPAY_SECRET_KEY=
SASPAY_WEBHOOK_SECRET=
SASPAY_API_URL=https://api.saspay.me/api/v1
SASPAY_RETURN_URL=https://stokeya.com/payment/success
SASPAY_DEFAULT_COUNTRY=SN
